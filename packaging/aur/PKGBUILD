# Maintainer: Emilian
pkgname=dotfileswitcher
pkgver=0.1.0
pkgrel=1
pkgdesc="Install, update, and switch multiple Hyprland dotfile distributions side by side"
arch=("any")
url="https://github.com/NexaStack-Software/dotswitcher"
license=("MIT")
depends=("python" "git" "hyprland")
makedepends=("python-build" "python-installer" "python-wheel")
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=("SKIP")

build() {
  cd "$pkgname-$pkgver"
  python -m build --wheel --no-isolation
}

package() {
  cd "$pkgname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 SPEC.md "$pkgdir/usr/share/doc/$pkgname/SPEC.md"
}
